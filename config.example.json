{
  "llm": {
    "provider": "openai",
    "api_key": "YOUR_API_KEY_HERE",
    "base_url": "https://api.openai.com/v1",
    "chat_model": "YOUR_CHAT_MODEL",
    "embed_model": "YOUR_EMBED_MODEL",
    "client_backend": "httpx",
    "endpoint_overrides": {},
    "step_models": {
      "preprocess": "",
      "memory_extract": "",
      "category_update": "",
      "reflection": "",
      "ranking": "",
      "consolidation": ""
    }
  },
  "storage": {
    "resources_dir": "./resources",
    "metadata_store": {
      "provider": "sqlite",
      "dsn": "./sqlite/memu.db",
      "ddl_mode": "create"
    },
    "sqlite_dir": "./sqlite"
  },
  "mcp": {
    "http_path": "/mcp",
    "sse_path": "/sse"
  },
  "listen": {
    "host": "127.0.0.1",
    "port": 8099
  },
  "memu": {
    "path": "/path/to/memU/src"
  },
  "python": {
    "executable": "",
    "force_venv": false
  },
  "pid_file": "./.memu-server.pid",
  "categories": {
    "defaults": [
      {
        "name": "Identity",
        "description": "Who the participants are as people — their character, traits, personality, inner life, and characteristic ways of being"
      },
      {
        "name": "Preferences",
        "description": "What the participants value, enjoy, dislike, or are drawn toward"
      },
      {
        "name": "Relationships",
        "description": "The bond between participants — its texture, history, and quality of connection"
      },
      {
        "name": "Experiences",
        "description": "Meaningful moments — lived, shared, or dreamed — that reveal or shape who someone is or how they relate"
      }
    ],
    "max_total": 12,
    "allow_dynamic_categories": true,
    "dynamic_category_cluster_size": 3,
    "category_centroid_threshold": 0.65,
    "homeless_trigger_count": 10
  },
  "memorize": {
    "min_chunk_tokens": 4000,
    "max_chunk_tokens": 8000,
    "history_tail_after_memorize": 3000
  },
  "retrieve": {
    "method": "rag",
    "apimw_enabled": true,
    "apimw_cadence": 5,
    "apimw_memory_count": 25,
    "apimw_random_count": 5
  },
  "consolidation_interval_days": 7,
  "turn_response_sentences": 4,
  "debug": {
    "log_prompts": false
  }
}
