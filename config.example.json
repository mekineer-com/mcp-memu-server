{
  "claude_code": false,
  "claude_code_model": "claude-opus-4-7",
  "claude_code_effort": "medium",
  "claude_code_permission_mode": "default",
  "claude_code_settings": "",
  "claude_code_workspace": "~/.cache/memu-claude-workspace",
  "claude_code_timeout_seconds": 3600,
  "llm": {
    "provider": "openai",
    "api_key": "YOUR_API_KEY_HERE",
    "base_url": "https://api.openai.com/v1",
    "chat_model": "YOUR_CHAT_MODEL",
    "embed_model": "YOUR_EMBED_MODEL",
    "embed_batch_size": 1,
    "temperature": null,
    "max_tokens": null,
    "client_backend": "httpx",
    "endpoint_overrides": {},
    "step_models": {
      "preprocess": "",
      "memory_extract": "",
      "category_update": "",
      "reflection": "",
      "consolidation": ""
    },
    "step_temperatures": {
      "preprocess": "",
      "memory_extract": "",
      "category_update": "",
      "reflection": "",
      "consolidation": "",
      "holistic_summary": 0.3
    }
  },
  "storage": {
    "resources_dir": "./resources",
    "metadata_store": {
      "provider": "sqlite",
      "dsn": "./sqlite/memu.db",
      "ddl_mode": "create"
    },
    "sqlite_dir": "./sqlite"
  },
  "hermes": {
    "home": "../hermes-channels/data",
    "whatsapp_history_source": "web_source",
    "whatsapp_web_source_db": "../hermes-channels/data/whatsapp/web_source.db",
    "whatsapp_reply_prefix": "",
    "whatsapp_history_limit": 250
  },
  "mcp": {
    "http_path": "/mcp",
    "sse_path": "/sse"
  },
  "listen": {
    "host": "127.0.0.1",
    "port": 8099
  },
  "memu": {
    "path": "/path/to/memU/src"
  },
  "python": {
    "executable": "",
    "force_venv": false
  },
  "pid_file": "./.memu-server.pid",
  "categories": {
    "defaults": [
      {
        "name": "Identity",
        "description": "Who the participants are as people — their character, traits, personality, inner life, and characteristic ways of being"
      },
      {
        "name": "Preferences",
        "description": "What the participants value, enjoy, dislike, or are drawn toward"
      },
      {
        "name": "Relationships",
        "description": "The bond between participants — its texture, history, and quality of connection"
      },
      {
        "name": "Experiences",
        "description": "Meaningful moments — lived, shared, or dreamed — that reveal or shape who someone is or how they relate"
      }
    ],
    "max_total": 12,
    "dynamic_category_cluster_size": 10,
    "category_summary_target_length": 300
  },
  "memorize": {
    "min_chunk_tokens": 8000,
    "episode_items_per_segment": 3,
    "background_summary_tokens": 1000,
    "background_extra_messages_tokens": 100,
    "enable_confidence_normalization": false,
    "semantic_dedupe_enabled": true,
    "semantic_dedupe_similarity_threshold": 0.85
  },
  "retrieve": {
    "apimw_enabled": true,
    "apimw_cadence": 5,
    "apimw_memory_count": 20,
    "apimw_random_count": 5,
    "mental_health_query": true
  },
  "consolidation_interval_days": 7,
  "turn_response_sentences": 4,
  "debug": {
    "log_prompts": false
  }
}
